[
 {
  "text": "That task you keep putting off?",
  "start": 0.0,
  "end": 1.636
 },
 {
  "text": "It's not too big.",
  "start": 1.986,
  "end": 3.155
 },
 {
  "text": "Starting is just hard.",
  "start": 3.455,
  "end": 5.003
 },
 {
  "text": "So try the two-minute rule.",
  "start": 5.453,
  "end": 7.126
 },
 {
  "text": "If it takes less than two minutes,",
  "start": 7.576,
  "end": 9.368
 },
 {
  "text": "do it now.",
  "start": 9.488,
  "end": 10.272
 },
 {
  "text": "If it's bigger,",
  "start": 10.722,
  "end": 11.594
 },
 {
  "text": "just do the first two minutes.",
  "start": 11.714,
  "end": 13.321
 },
 {
  "text": "Don't read the book.",
  "start": 13.771,
  "end": 14.951
 },
 {
  "text": "Read one page.",
  "start": 15.101,
  "end": 16.264
 },
 {
  "text": "Don't go for a run.",
  "start": 16.664,
  "end": 17.824
 },
 {
  "text": "Put on your shoes.",
  "start": 17.974,
  "end": 19.04
 },
 {
  "text": "Don't clean the kitchen.",
  "start": 19.49,
  "end": 20.772
 },
 {
  "text": "Wash one plate.",
  "start": 20.922,
  "end": 22.05
 },
 {
  "text": "Once you start,",
  "start": 22.5,
  "end": 23.478
 },
 {
  "text": "you usually keep going.",
  "start": 23.598,
  "end": 25.015
 },
 {
  "text": "Two minutes.",
  "start": 25.515,
  "end": 26.285
 },
 {
  "text": "Start now.",
  "start": 26.535,
  "end": 27.403
 }
]