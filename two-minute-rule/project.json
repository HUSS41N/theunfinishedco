 "captions": [
  {
   "start": 0.3,
   "end": 2.016,
   "text": "That task you keep putting off?"
  },
  {
   "start": 2.286,
   "end": 3.535,
   "text": "It's not too big."
  },
  {
   "start": 3.755,
   "end": 5.383,
   "text": "Starting is just hard."
  },
  {
   "start": 5.753,
   "end": 7.506,
   "text": "So try the two-minute rule."
  },
  {
   "start": 7.876,
   "end": 9.748,
   "text": "If it takes less than two minutes,"
  },
  {
   "start": 9.788,
   "end": 10.652,
   "text": "do it now."
  },
  {
   "start": 11.022,
   "end": 11.974,
   "text": "If it's bigger,"
  },
  {
   "start": 12.014,
   "end": 13.701,
   "text": "just do the first two minutes."
  },
  {
   "start": 14.071,
   "end": 15.331,
   "text": "Don't read the book."
  },
  {
   "start": 15.401,
   "end": 16.644,
   "text": "Read one page."
  },
  {
   "start": 16.964,
   "end": 18.204,
   "text": "Don't go for a run."
  },
  {
   "start": 18.274,
   "end": 19.42,
   "text": "Put on your shoes."
  },
  {
   "start": 19.79,
   "end": 21.152,
   "text": "Don't clean the kitchen."
  },
  {
   "start": 21.222,
   "end": 22.43,
   "text": "Wash one plate."
  },
  {
   "start": 22.8,
   "end": 23.858,
   "text": "Once you start,"
  },
  {
   "start": 23.898,
   "end": 25.395,
   "text": "you usually keep going."
  },
  {
   "start": 25.815,
   "end": 26.665,
   "text": "Two minutes."
  },
  {
   "start": 26.835,
   "end": 27.783,
   "text": "Start now."
  }
 ],
